#version 460
// BDPT / VCM の光源側：画素ごとに 1 本の光源側の経路を作り、拡散・光沢の頂点を保存する（接続と近傍のまとめ用）。
// 各頂点はカメラへ直接つなぎ（t = 1 の戦略）、寄与を画面のバッファへ足し込む
#extension GL_GOOGLE_include_directive : require
#include "stage.glsl"  // 計算シェーダ（ray query）か、レイ生成シェーダ（ray tracing pipeline）か

#include "common.glsl"
#include "spectral.glsl"
#include "sampling.glsl"
#include "noise.glsl"
#include "bsdf.glsl"
#include "env.glsl"
#include "scene.glsl"
#include "lights.glsl"
#include "ptcore.glsl"
#include "bidir.glsl"
#include "camera.glsl"

// 光源側の頂点をカメラへつなぐ（光線の追跡で画面へ足し込む）
void connectToCamera(SubPath sp, Shade s, vec3 pos, vec3 ng, vec3 ns, vec3 wo, VcmConst vc, float contProb,
                     inout Rng rng) {
    CameraConnection cc;
    if (!connectToLens(pos, rng, cc)) return;
    vec3 toCam = cc.lensPos - pos;
    float dist2 = dot(toCam, toCam);
    float dist = sqrt(dist2);
    vec3 dirToCam = toCam / dist;
    vec2 raster = cc.raster;
    float cosAtCamera = cc.cosAtCamera;
    if (dot(dirToCam, ng) <= 0.0) return;
    vec3 t, b;
    basis(ns, t, b);
    vec3 v = toLocal(wo, t, b, ns), l = toLocal(dirToCam, t, b, ns);
    if (v.z <= 0.0 || l.z <= 0.0) return;
    vec4 f = bsdfEval(s, v, l) * shadingCorrection(wo, dirToCam, ns, ng);
    if (f.x + f.y + f.z + f.w <= 0.0) return;
    float revPdfW = bsdfPdf(s, l, v) * contProb;

    // 画像の 1 画素あたり → 面の上の面積あたりへの変換
    float imagePointToCameraDist = imagePlaneDist() * cc.imageScale / cosAtCamera;
    float imageToSolidAngle = imagePointToCameraDist * imagePointToCameraDist / cosAtCamera;
    float imageToSurface = imageToSolidAngle * l.z / dist2;
    float cameraPdfA = imageToSurface;
    float wLight = Mis(cameraPdfA / lightPathCount()) * (vc.vmWeight + sp.dVCM + sp.dVC * Mis(revPdfW));
    float misWeight = 1.0 / (wLight + 1.0);
    vec4 c = misWeight * sp.throughput * f * (imageToSurface / lightPathCount()) * cc.weight;
    bool terminated = sp.terminated || cameraIsChromatic();
    c = maskTerminated(c, terminated);
    gClampScale = cc.weight;
    // 頂点の数：カメラから見た最初の頂点がこの（鏡面でない）頂点なので、光源からここまでの頂点（sp.pathLength 個）をすべて数える
    c = clampIndirect(c, sp.pathLength, terminated);
    if (c.x + c.y + c.z + c.w <= 0.0) return;
    vec3 p0 = offsetRay(pos, ng);
    vec3 d = cc.lensPos - p0;
    float dl = length(d);
    if (occludedDist(p0, d / dl, dl)) return;
    vec3 o = toOutputColor(c);
    if (any(isnan(o)) || any(isinf(o))) return;
    uvec2 px = min(uvec2(raster), F.dims.xy - 1u);
    uint i = splatIndex(px);
    atomicAdd(splat[i + 0u], o.x);
    atomicAdd(splat[i + 1u], o.y);
    atomicAdd(splat[i + 2u], o.z);
}

void main() {
    uvec2 px = KRBR_INVOCATION_ID.xy;
    if (px.x >= F.dims.x || px.y >= F.dims.y) return;
    uint pathIdx = px.y * F.dims.x + px.x;
    Rng rng = rngInit(px, pc.sampleIndex, pc.seed ^ RNG_STREAM_LIGHT_PATH);
    bidirWavelengths(pathIdx);
    VcmConst vc = vcmConst();
    float cellSize = 2.0 * vc.radius;

    LightEmission le;
    if (!emitLight(rng, le)) return;
    SubPath sp;
    sp.origin = le.origin;
    sp.dir = le.dir;
    sp.throughput = spectralMode() ? le.throughput : vec4(le.throughput.rgb, 0.0);
    sp.pathLength = 1u;
    sp.finiteLight = le.finite;
    sp.dVCM = Mis(le.directPdf / le.emissionPdfW);
    sp.dVC = Mis((le.finite ? le.cosLight : 1.0) / le.emissionPdfW);
    sp.dVM = sp.dVC * vc.vcWeight;
    sp.terminated = false;
    sp.mediumSigma = vec4(0.0);

    uint prev = NO_VERTEX;
    for (;;) {
        Hit hit;
        if (!traceClosest(sp.origin, sp.dir, hit)) break;
        if (any(greaterThan(sp.mediumSigma, vec4(0.0)))) sp.throughput *= exp(-sp.mediumSigma * hit.t);
        vec3 wo = -sp.dir;
        bool frontFace;
        vec3 ng, ns;
        orientNormals(hit, wo, frontFace, ng, ns);
        // カメラ側で作り直すとき（shadeLightVertex）と同じ値になるよう、法線は圧縮した値を使い、材質は保存する乱数から作る
        uint ngE = octEncode(ng), nsE = octEncode(ns);
        ng = octDecode(ngE);
        ns = octDecode(nsE);
        Hit h = rebuildHit(hit.pos, hit.pObj, ng, ns, hit.instance, hit.material);
        uint shadeSeed = pcgHash(rng.state);
        rnd(rng);
        Rng srng;
        srng.state = shadeSeed;
        vec3 nsS = ns;
        bool dispersive;
        Shade s = shadeVertex(h, wo, frontFace, nsS, srng, dispersive);
        // 分散で代表波長以外を打ち切る。重みは書き換えず、寄与を作るときに maskTerminated でかける
        if (dispersive) sp.terminated = true;
        misOnHit(sp, hit.t, dot(nsS, wo), true);

        // 基材の中へ入る光（subsurface）は、カメラ側の経路が単方向で扱う
        if (s.sssWeight > 0.0 && rnd(rng) < s.sssWeight) break;

        bool delta = isDeltaLike(s);
        float contProb = continuationProb(s);
        if (!delta) {
            // 容量を超えた頂点は保存しない（数は数え続け、Rust 側が容量を増やすか知らせる。保存できなかった頂点への
            // 接続・まとめは行われず、その分の光が欠ける）
            uint idx = atomicAdd(counters[KRBR_VCM_COUNTER_STORED], 1u);
            if (idx < counters[KRBR_VCM_COUNTER_CAPACITY]) {
                LightVertex lv;
                lv.posInst = vec4(hit.pos, uintBitsToFloat(hit.instance));
                lv.pObjMat = vec4(hit.pObj, uintBitsToFloat(hit.material));
                lv.dirs = uvec4(ngE, nsE, octEncode(wo), shadeSeed);
                lv.throughput = sp.throughput;
                lv.mis = vec4(sp.dVCM, sp.dVC, sp.dVM, contProb);
                lv.links = uvec4(prev, NO_VERTEX, sp.pathLength, sp.terminated ? 1u : 0u);
                if (useMerging()) lv.links.y = atomicExchange(cellHead[cellHash(cellOf(hit.pos, cellSize))], idx);
                lightVerts[idx] = lv;
                prev = idx;
                pathHead[pathIdx] = idx;
            }
            if (sp.pathLength + 1u <= maxPathLength()) connectToCamera(sp, s, hit.pos, ng, nsS, wo, vc, contProb, rng);
        }
        if (sp.pathLength + 2u > maxPathLength()) break;
        if (!scatterSubPath(sp, s, hit.pos, ng, nsS, wo, frontFace, delta, contProb, true, vc, rng)) break;
        ++sp.pathLength;
    }
}
