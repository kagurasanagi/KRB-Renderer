#version 460
// 表示用：累積画像に露出とグロー（glow.comp で作ったピラミッドの最上段）をかけ、ACES（Hill 近似）でトーンマッピングし sRGB の RGBA8 にする。
// rust/crates/krbr-render/src/image_io.rs の tonemap_rgba8 と同じ式にそろえること
#extension GL_GOOGLE_include_directive : require
#include "postfx.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D accumColor;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D accumAlbedo;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D accumNormal;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outImage;
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D glowImage;
// カメラの光線が最初に当たった点の和と、当たったサンプルの数（A）。背景を透明にしたときのアルファに使う
layout(set = 0, binding = 5, rgba32f) uniform readonly image2D accumPosition;

layout(push_constant) uniform Push {
    float exposureScale;
    uint mode;  // 0: 画像, 1: アルベド, 2: 法線
    uint width;
    uint height;
    vec4 xyzToRgb0;  // 入力が XYZ（分光モード）のとき、リニア sRGB への変換の列。w = 1 なら変換する
    vec4 xyzToRgb1;
    vec4 xyzToRgb2;
    vec4 glow;       // x: 強さ / 段の重みの合計（0 ならグローなし）, y, z: glowImage の大きさ
    vec4 background; // x: 0 = 不透明（アルファを使わない）, 1 = 市松模様の上に合成（表示）, 2 = アルファを付けて出す（保存）。y: 市松の 1 マス（画素）
} pc;

vec3 toRgb(vec3 c) { return applyColorMatrix(c, pc.xyzToRgb0, pc.xyzToRgb1, pc.xyzToRgb2); }

vec3 acesFitted(vec3 c) {
    const mat3 inM = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
    const mat3 outM = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);
    vec3 v = inM * c;
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return outM * (a / b);
}

vec3 glowAt(ivec2 q) {
    q = clamp(q, ivec2(0), ivec2(int(pc.glow.y) - 1, int(pc.glow.z) - 1));
    return imageLoad(glowImage, q).rgb;
}

// グローの最上段（半分の解像度）を双線形で広げる
vec3 glowSample(uvec2 p) {
    vec2 f = halfResCoord(p);
    vec2 f0 = floor(f);
    vec2 t = f - f0;
    ivec2 q = ivec2(f0);
    return mix(mix(glowAt(q), glowAt(q + ivec2(1, 0)), t.x), mix(glowAt(q + ivec2(0, 1)), glowAt(q + ivec2(1, 1)), t.x), t.y);
}

vec3 linearToSrgb(vec3 x) {
    x = clamp(x, 0.0, 1.0);
    return mix(12.92 * x, 1.055 * pow(x, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), x));
}

// アルファ：当たったサンプルの数 / 数えたサンプルの数（アルベドの A。レンズの中で遮られたサンプルは数えない）。
// Progressive::readback と同じ
float coverage(ivec2 ip) {
    float n = imageLoad(accumAlbedo, ip).a;
    return n > 0.0 ? clamp(imageLoad(accumPosition, ip).a / n, 0.0, 1.0) : 0.0;
}

// 透明な所の市松模様（sRGB）
vec3 checker(uvec2 p) {
    uvec2 q = p / uint(max(pc.background.y, 1.0));
    return vec3(((q.x + q.y) & 1u) == 0u ? 0.42 : 0.32);
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.width || p.y >= pc.height) return;
    ivec2 ip = ivec2(p);
    vec3 c;
    float alpha = 1.0;
    if (pc.mode == 1u) {
        vec4 a = imageLoad(accumAlbedo, ip);
        c = linearToSrgb(a.a > 0.0 ? toRgb(a.rgb / a.a) : vec3(0.0));
    } else if (pc.mode == 2u) {
        vec4 n = imageLoad(accumNormal, ip);
        c = n.a > 0.0 ? n.rgb / n.a * 0.5 + 0.5 : vec3(0.0);
    } else {
        vec4 a = imageLoad(accumColor, ip);
        vec3 l = resolveAccum(a, pc.xyzToRgb0, pc.xyzToRgb1, pc.xyzToRgb2, pc.exposureScale);
        // 背景が透明なら、色はアルファを掛けた値なので割り戻す（グローは物の上にだけ足す。image_io.rs の tonemap_rgba8 と同じ）
        if (pc.background.x > 0.5) {
            alpha = coverage(ip);
            l = alpha > 0.0 ? l / alpha : vec3(0.0);
        }
        if (pc.glow.x > 0.0 && alpha > 0.0) l += glowSample(p) * pc.glow.x;
        c = linearToSrgb(acesFitted(l));
        // 量子化の縞を減らす小さなディザ
        uint i = p.y * pc.width + p.x;
        c += (float((i * 2654435761u) & 255u) / 255.0 - 0.5) / 255.0;
        if (pc.background.x > 0.5 && pc.background.x < 1.5) {
            c = mix(checker(p), clamp(c, 0.0, 1.0), alpha);
            alpha = 1.0;
        }
    }
    imageStore(outImage, ip, vec4(clamp(c, 0.0, 1.0), alpha));
}
