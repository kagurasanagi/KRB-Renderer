#version 460
// 単方向パストレーサー（光源の直接サンプリング ＋ BSDF サンプリングを MIS で結合）
// 1 回の dispatch で各画素 1 サンプルを追加する
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "common.glsl"
#include "spectral.glsl"
#include "sampling.glsl"
#include "noise.glsl"
#include "bsdf.glsl"
#include "env.glsl"
#include "scene.glsl"
#include "lights.glsl"
#include "ptcore.glsl"

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= F.dims.x || px.y >= F.dims.y) return;
    Rng rng = rngInit(px, pc.sampleIndex, pc.seed);
    bool spectral = spectralMode();
    if (spectral) sampleWavelengths(rnd(rng));

    // 画素内のジッタ（箱フィルタ）
    vec2 jitter = rnd2(rng);
    vec2 ndc = (vec2(px) + jitter) / vec2(F.dims.xy) * 2.0 - 1.0;

    PtState st;
    st.origin = F.camPos.xyz;
    st.dir = normalize(F.camForward.xyz + ndc.x * F.camRight.xyz - ndc.y * F.camUp.xyz);
    st.beta = spectral ? vec4(1.0) : vec4(1.0, 1.0, 1.0, 0.0);
    st.prevPdf = 0.0;
    st.inside = false;
    st.insideSigma = vec4(0.0);
    st.mediumSigma = vec4(0.0);
    st.terminated = false;
    vec3 albedo = vec3(0.0), normal = vec3(0.0);
    vec4 L = ptTrace(st, 0u, rng, albedo, normal);

    vec3 color = spectral ? spectrumToXyz(L) : L.rgb;
    if (any(isnan(color)) || any(isinf(color))) color = vec3(0.0);
    if (spectral) albedo = rgbToXyz(albedo);

    ivec2 ip = ivec2(px);
    if (pc.sampleIndex == 0u) {
        imageStore(accumColor, ip, vec4(color, 1.0));
        imageStore(accumAlbedo, ip, vec4(albedo, 1.0));
        imageStore(accumNormal, ip, vec4(normal, 1.0));
    } else {
        imageStore(accumColor, ip, imageLoad(accumColor, ip) + vec4(color, 1.0));
        imageStore(accumAlbedo, ip, imageLoad(accumAlbedo, ip) + vec4(albedo, 1.0));
        imageStore(accumNormal, ip, imageLoad(accumNormal, ip) + vec4(normal, 1.0));
    }
}
