#version 460
// 単方向パストレーサー（光源の直接サンプリング ＋ BSDF サンプリングを MIS で結合）
// 1 回の dispatch で各画素 1 サンプルを追加する
#extension GL_GOOGLE_include_directive : require
#include "stage.glsl"  // 計算シェーダ（ray query）か、レイ生成シェーダ（ray tracing pipeline）か

#include "common.glsl"
#include "spectral.glsl"
#include "sampling.glsl"
#include "noise.glsl"
#include "bsdf.glsl"
#include "env.glsl"
#include "scene.glsl"
#include "lights.glsl"
#include "ptcore.glsl"
#include "camera.glsl"

void main() {
    uvec2 px = KRBR_INVOCATION_ID.xy;
    if (px.x >= F.dims.x || px.y >= F.dims.y) return;
    Rng rng = rngInit(px, pc.sampleIndex, pc.seed);
    bool spectral = spectralMode();
    if (spectral) sampleWavelengths(rnd(rng));

    // 画素内のジッタ（箱フィルタ）
    vec2 jitter = rnd2(rng);
    vec2 ndc = (vec2(px) + jitter) / vec2(F.dims.xy) * 2.0 - 1.0;

    CameraRay cr = generateCameraRay(ndc, rng);
    PtState st;
    st.origin = cr.origin;
    st.dir = cr.dir;
    st.beta = (spectral ? vec4(1.0) : vec4(1.0, 1.0, 1.0, 0.0)) * cr.weight;
    st.prevPdf = 0.0;
    st.prevNee = false;
    st.inside = false;
    st.insideSigma = vec4(0.0);
    st.mediumSigma = vec4(0.0);
    st.terminated = cameraIsChromatic();  // 色収差：波長で光線が変わるので代表波長だけを追う
    st.rough = 0u;
    if (st.terminated) st.beta = heroOnly(st.beta);
    gClampScale = cr.weight;
    vec3 albedo = vec3(0.0), normal = vec3(0.0);
    vec4 L = cr.weight > 0.0 ? ptTrace(st, 0u, rng, albedo, normal) : vec4(0.0);

    vec3 color = spectral ? spectrumToXyz(L) : L.rgb;
    if (spectral) albedo = rgbToXyz(albedo);
    accumulate(ivec2(px), color, albedo, normal);
}
