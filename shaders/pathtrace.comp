#version 460
// 単方向パストレーサー（環境光の NEE ＋ BSDF サンプリングを MIS で結合）
// 1 回の dispatch で各画素 1 サンプルを追加する
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "common.glsl"
#include "spectral.glsl"
#include "sampling.glsl"
#include "noise.glsl"
#include "bsdf.glsl"
#include "env.glsl"

struct Hit {
    vec3 pos;
    float t;    // 光線の始点からの距離
    vec3 pObj;  // オブジェクト座標（表面の模様をインスタンスに貼り付けるため）
    vec3 ng;    // 幾何法線（ワールド、正規化済み）
    vec3 ns;    // シェーディング法線
    mat3 w2o;   // ワールド -> オブジェクトの 3x3（勾配・法線の変換用）
    uint instance;
    uint material;
};

bool traceClosest(vec3 origin, vec3 dir, out Hit hit) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.0, dir, 1e30);
    while (rayQueryProceedEXT(rq)) {
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) return false;

    InstanceInfo ii = instanceInfos[uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true))];
    uint meshId = ii.mesh;
    uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
    mat4x3 w2o = rayQueryGetIntersectionWorldToObjectEXT(rq, true);

    MeshInfo mi = meshes[meshId];
    uint i0 = indices[mi.indexOffset + prim * 3u + 0u] + mi.vertexOffset;
    uint i1 = indices[mi.indexOffset + prim * 3u + 1u] + mi.vertexOffset;
    uint i2 = indices[mi.indexOffset + prim * 3u + 2u] + mi.vertexOffset;
    Vertex v0 = vertices[i0], v1 = vertices[i1], v2 = vertices[i2];
    float w0 = 1.0 - bc.x - bc.y;
    vec3 pObj = w0 * v0.pos + bc.x * v1.pos + bc.y * v2.pos;
    vec3 nObj = w0 * v0.nrm + bc.x * v1.nrm + bc.y * v2.nrm;
    vec3 ngObj = cross(v1.pos - v0.pos, v2.pos - v0.pos);

    hit.w2o = mat3(w2o);
    hit.t = rayQueryGetIntersectionTEXT(rq, true);
    hit.pObj = pObj;
    hit.pos = o2w * vec4(pObj, 1.0);
    hit.ng = normalize(ngObj * hit.w2o);  // 法線は逆転置で変換
    vec3 ns = nObj * hit.w2o;
    hit.ns = dot(ns, ns) > 1e-20 ? normalize(ns) : hit.ng;
    hit.instance = uint(rayQueryGetIntersectionInstanceIdEXT(rq, true));
    hit.material = ii.materialBase + triMats[mi.triOffset + prim];
    return true;
}

bool occluded(vec3 origin, vec3 dir) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, origin, 0.0, dir,
                          1e30);
    while (rayQueryProceedEXT(rq)) {
    }
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

// ---------------------------------------------------------------- 表面の微細な凹凸

struct Detail {
    vec3 grad;       // 高さの勾配（オブジェクト座標、傾きの単位）
    float roughMul;  // 粗さへの倍率
    float colorMul;  // 色への倍率
};

void addDetail(Material m, vec3 pObj, vec3 nObj, vec3 seed, float weight, inout Detail d) {
    uint pattern = uint(m.params2.x);
    float strength = m.params2.y * weight;
    float scale = max(m.params2.z, 1e-4);
    float rv = m.params2.w * weight;
    if (pattern == BUMP_NOISE) {
        vec4 n = fbmd(pObj / scale + seed);
        d.grad += strength * n.yzw;
    } else if (pattern == BUMP_WEAVE) {
        float h;
        if (abs(nObj.y) > 0.5) {
            // 基板の面（XZ）に沿った織り目。糸と樹脂で色もわずかに変わる
            vec3 g = weaveGrad(pObj.xz / scale, h);
            d.grad += strength * vec3(g.x, 0.0, g.y);
        } else {
            // 側面・穴の内壁：ガラス布が水平に重なった層（約 0.1 mm ごと）
            vec4 n = noised(vec3((pObj.x + pObj.z) / scale, pObj.y / 0.05, 0.5) + seed);
            h = 0.5 + 0.5 * sin(pObj.y / 0.05 * PI + 1.5 * n.x);
            d.grad += strength * 0.5 * vec3(0.0, cos(pObj.y / 0.05 * PI) * PI / 0.05 * 0.02, 0.0);
        }
        d.colorMul *= mix(1.0, mix(0.86, 1.06, h), weight);
    }
    if (rv > 0.0) {
        float r = noised(pObj / (scale * 2.7) + seed + vec3(31.7, 7.1, 3.3)).x;
        d.roughMul *= clamp(1.0 + 2.0 * rv * r, 0.3, 2.0);
    }
}

vec3 instanceSeed(uint instance) {
    uint h = pcgHash(instance + 1u);
    return vec3(float(h & 1023u), float((h >> 10) & 1023u), float((h >> 20) & 1023u)) * 0.37;
}

// 基板面（層テクスチャ方式）：R=銅, G=レジスト開口, B=シルク から材質を確率的に選ぶ
Shade boardShade(vec3 p, uint side, inout Rng rng, out uint detailMat, out uint maskMat) {
    vec2 uv = vec2((p.x - F.boardMap.x) * F.boardMap.z, (p.z - F.boardMap.y) * F.boardMap.w);
    vec4 t = textureLod(boardTex, vec3(uv, float(side)), 0.0);
    float copper = t.r, open = t.g, silk = t.b;
    maskMat = 0xFFFFFFFFu;
    if (rnd(rng) < silk) {
        detailMat = F.boardMats2.x;
        return shadeFromMaterial(materials[detailMat]);
    }
    bool onCopper = rnd(rng) < copper;
    bool masked = rnd(rng) >= open;
    if (!masked) {
        detailMat = onCopper ? F.boardMats.z : F.boardMats.w;
        return shadeFromMaterial(materials[detailMat]);
    }
    detailMat = onCopper ? F.boardMats.y : F.boardMats.w;
    maskMat = F.boardMats.x;
    return shadeFromMaterial(materials[detailMat]);
}

// レジストを上にかぶせる（下の材質 s を、レジストのコートで覆う）。thickness > 0 なら厚みに応じた吸収と散乱
Shade applyMask(Shade s, Material mask, float thickness, inout Rng rng) {
    // レジストの顔料自身による散乱。厚いほど起きやすい（基準の厚みで mask の base_weight になる）
    float scatterProb = mask.baseColor.a;
    float tRef = F.maskParams.x;
    if (thickness > 0.0 && tRef > 0.0) {
        float k = -log(max(1.0 - mask.baseColor.a, 1e-3)) / tRef;
        scatterProb = 1.0 - exp(-k * thickness);
    }
    if (rnd(rng) < scatterProb) {
        s = shadeFromMaterial(mask);
        s.baseWeight = 1.0;
    }
        s.coatWeight = mask.params0.w;
    s.coatColor = specReflect(mask.coatColor.rgb, mask.specCoat);
    s.coatRgb = mask.coatColor.rgb;
    s.coatRoughness = mask.coatColor.a;
    s.coatIor = mask.params1.x;
    if (thickness > 0.0 && tRef > 0.0) {
        // coat_color は「基準の厚みを垂直に往復したときの透過率」。そこから吸収係数を求める
        s.coatSigma = -log(max(s.coatColor, vec4(1e-4))) / (2.0 * tRef);
        s.coatThickness = thickness;
    }
    return s;
}

// ---------------------------------------------------------------- レジストの厚み t(x)（距離場から）

float sdfDecode(float v) { return (v * 255.0 - 128.0) / 127.0 * 0.3; }

vec2 boardSdf(vec3 p, uint side) {
    vec2 uv = vec2((p.x - F.boardMap.x) * F.boardMap.z, (p.z - F.boardMap.y) * F.boardMap.w);
    vec4 t = textureLod(boardTex, vec3(uv, float(side)), 0.0);
    return vec2(sdfDecode(t.r), sdfDecode(t.g));  // x: 銅の縁からの距離, y: レジスト開口の縁からの距離（外側が正）
}

// dc: 銅の縁からの距離（銅の外が正）, dm: レジスト開口の縁からの距離（レジストのある側が正）
float maskThickness(float dc, float dm) {
    float t;
    if (dc < 0.0) {
        // 銅の上：縁で流れて薄くなり、中央に向かって設定の厚みに近づく
        t = F.maskParams.z + (F.maskParams.x - F.maskParams.z) * (1.0 - exp(-(-dc) / F.maskParams.w));
    } else {
        // 基材の上：銅の壁ぎわにたまって厚くなる
        t = F.maskParams.y + F.maskParams2.x * exp(-dc / F.maskParams2.y);
    }
    // レジスト開口の縁に向かっても薄くなる
    return t * (0.35 + 0.65 * smoothstep(0.0, 0.05, dm));
}

// レジストの表面の高さ（基材の面から）。銅の縁は、レジストに覆われてなだらかになる
float maskSurfaceHeight(float dc, float dm) {
    float copper = F.maskParams2.z * (1.0 - smoothstep(-0.04, 0.04, dc));
    return copper + maskThickness(dc, dm);
}

// 交点の材質と、凹凸で揺らした法線を求める
Shade surfaceAt(Hit hit, inout vec3 ns, inout Rng rng) {
    Material m = materials[hit.material];
    uint kind = uint(m.params1.y);
    vec3 seed = instanceSeed(hit.instance);
    vec3 nObj = normalize(hit.w2o * ns);  // 法線をオブジェクト座標へ（剛体変換なら w2o をそのまま掛ける）
    Detail d = Detail(vec3(0.0), 1.0, 1.0);
    Shade s;
    uint maskMat = 0xFFFFFFFFu;
    uint baseMat = hit.material;
    if (kind == MAT_BOARD) {
        s = boardShade(hit.pos, uint(m.params1.z), rng, baseMat, maskMat);
    } else if (kind == MAT_MASKED) {
        baseMat = uint(m.params1.z);
        maskMat = uint(m.params1.w);
        s = shadeFromMaterial(materials[baseMat]);
    } else {
        s = shadeFromMaterial(m);
    }

    if (maskMat != 0xFFFFFFFFu) {
        Material mask = materials[maskMat];
        // レジストの表面はレジストの凹凸。下が基材なら織り目がうっすら浮き出る
        addDetail(mask, hit.pObj, nObj, seed, 1.0, d);
        Material base = materials[baseMat];
        if (uint(base.params2.x) == BUMP_WEAVE) addDetail(base, hit.pObj, nObj, seed, 0.12, d);
        float thickness = 0.0;
        if (kind == MAT_MASKED && F.maskParams2.w > 0.5 && abs(nObj.y) > 0.5) {
            // 距離場からレジストの厚みと、縁のなだらかな傾き（法線）を求める
            uint side = nObj.y > 0.0 ? 0u : 1u;
            vec2 sd = boardSdf(hit.pos, side);
            thickness = maskThickness(sd.x, sd.y);
            const float e = 0.01;  // 有限差分の幅（mm）
            vec2 sx = boardSdf(hit.pos + vec3(e, 0, 0), side), sz = boardSdf(hit.pos + vec3(0, 0, e), side);
            float h0 = maskSurfaceHeight(sd.x, sd.y);
            float dhx = (maskSurfaceHeight(sx.x, sx.y) - h0) / e;
            float dhz = (maskSurfaceHeight(sz.x, sz.y) - h0) / e;
            // 表面の高さは外向き（表は +Y、裏は -Y）に測るので、勾配はそのまま法線から引く
            d.grad += vec3(dhx, 0.0, dhz);
        }
        s.baseColor *= d.colorMul;
        s.baseRgb *= d.colorMul;
        const float sssWeight = s.sssWeight;  // 下の材質（基材）の拡散の透過
        const vec4 sssSigma = s.sssSigma;
        s = applyMask(s, mask, thickness, rng);
        s.sssWeight = sssWeight;
        s.sssSigma = sssSigma;
        s.metallic = materials[baseMat].params0.x > 0.5;
        s.coatRoughness = clamp(s.coatRoughness * d.roughMul, 0.02, 1.0);
    } else {
        addDetail(materials[baseMat], hit.pObj, nObj, seed, 1.0, d);
        s.baseColor *= d.colorMul;
        s.baseRgb *= d.colorMul;
        s.roughness = clamp(s.roughness * d.roughMul, 0.02, 1.0);
    }

    // 勾配をワールドへ（法線と同じく逆転置）、法線を傾ける
    vec3 g = d.grad * hit.w2o;
    vec3 gt = g - dot(g, ns) * ns;
    if (dot(gt, gt) > 0.0) {
        vec3 nb = normalize(ns - gt);
        if (dot(nb, ns) > 0.2) ns = nb;
    }
    return s;
}

vec4 clampRadiance(vec4 c) {
    float m = F.envParams.z;
    if (m <= 0.0) return c;
    float mx = max(max(c.x, c.y), max(c.z, c.w));
    return mx > m ? c * (m / mx) : c;
}

vec4 envSpectrum(vec3 dir) { return rgbToSpecUnbounded(envRadiance(dir)); }

// 透過する材質の屈折率（分光モードで分散があれば代表波長での値）
float iorOf(Material m) {
    if (spectralMode() && m.params3.w > 0.5) return m.params3.y + m.params3.z / (gLambda.x * gLambda.x);
    return m.params0.z;
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= F.dims.x || px.y >= F.dims.y) return;
    Rng rng = rngInit(px, pc.sampleIndex, pc.seed);
    bool spectral = spectralMode();
    if (spectral) sampleWavelengths(rnd(rng));

    // 画素内のジッタ（箱フィルタ）
    vec2 jitter = rnd2(rng);
    vec2 ndc = (vec2(px) + jitter) / vec2(F.dims.xy) * 2.0 - 1.0;
    vec3 dir = normalize(F.camForward.xyz + ndc.x * F.camRight.xyz - ndc.y * F.camUp.xyz);
    vec3 origin = F.camPos.xyz;

    vec4 L = vec4(0.0);
    vec4 beta = spectral ? vec4(1.0) : vec4(1.0, 1.0, 1.0, 0.0);
    vec3 albedo = vec3(0.0);
    vec3 normal = vec3(0.0);
    float prevPdf = 0.0;
    uint maxDepth = F.counts.x;
    // 基材の中を進んでいるか（拡散の透過で入ったとき）と、中での吸収係数
    bool inside = false;
    vec4 insideSigma = vec4(0.0);
    // 透明な物体（ガラス・アクリル）の中での吸収係数
    vec4 mediumSigma = vec4(0.0);
    bool secondaryTerminated = false;

    for (uint depth = 0u; depth < maxDepth; ++depth) {
        Hit hit;
        if (!traceClosest(origin, dir, hit)) {
            vec4 Le = envSpectrum(dir);
            if (depth == 0u) {
                L += Le;
                albedo = clamp(envRadiance(dir), 0.0, 1.0);
            } else if (prevPdf > 0.0) {  // prevPdf = 0 は基材の中など、直接サンプリングと組み合わせない経路（中から抜けた光は捨てる）
                float w = powerHeuristic(prevPdf, envPdfDir(dir));
                vec4 c = beta * Le * w;
                L += depth >= 2u ? clampRadiance(c) : c;  // 間接光だけを抑える（ホタル対策）
            }
            break;
        }
        // 透明な物体の中を通ってきた分の吸収
        if (any(greaterThan(mediumSigma, vec4(0.0)))) beta *= exp(-mediumSigma * hit.t);

        // 発光面（emission）。発光面を光源として直接サンプリングはしないので、当たったときにそのまま足す
        Material hm = materials[hit.material];
        vec4 Le = specUnbounded(hm.emission.rgb, hm.specEmission);
        if (Le.x + Le.y + Le.z + Le.w > 0.0) {
            L += depth == 0u ? Le : clampRadiance(beta * Le);
            if (depth == 0u) albedo = clamp(hm.emission.rgb, 0.0, 1.0);
        }

        vec3 wo = -dir;
        bool frontFace = dot(hit.ng, wo) > 0.0;  // 幾何法線は外向き（閉じた形状の表から当たった）
        // 光線の来た側に法線をそろえる（両面として扱う）
        vec3 ng = frontFace ? hit.ng : -hit.ng;
        vec3 ns = dot(hit.ns, ng) < 0.0 ? -hit.ns : hit.ns;
        if (dot(ns, wo) <= 0.0) ns = ng;

        vec3 nsBase = ns;
        Shade s = surfaceAt(hit, ns, rng);
        if (dot(ns, wo) <= 0.0) ns = nsBase;  // 凹凸で裏を向いた場合は元に戻す

        if (s.transWeight > 0.0) {
            // 透過する材質：v の側から見た相対屈折率。分散があれば、ここで代表波長以外を打ち切る
            float n = iorOf(materials[hit.material]);
            s.ior = frontFace ? n : 1.0 / n;
            if (spectral && hm.params3.w > 0.5 && !secondaryTerminated) {
                beta = vec4(beta.x * 4.0, 0.0, 0.0, 0.0);
                secondaryTerminated = true;
            }
        }

        if (inside) {
            // ---- 基材の中から面に当たった：ここまでの吸収をかけ、外へ拡散して出るか、中へはね返る
            beta *= exp(-insideSigma * hit.t);
            vec3 p = offsetRay(hit.pos, ng);  // ng は中側を向いている
            if (s.metallic || s.sssWeight <= 0.0 && s.coatWeight <= 0.0 && s.baseRgb.r > 0.5) {
                // 銅・不透明なシルクなど：中へ拡散してはね返る
                vec3 t, b;
                basis(ng, t, b);
                dir = toWorld(sampleCosineHemisphere(rnd2(rng)), t, b, ng);
                beta *= s.metallic ? s.baseColor * 0.8 : vec4(0.8);
                origin = p;
                prevPdf = 0.0;
                continue;
            }
            // 外へ出る：レジストがあれば、その厚みの吸収を受ける
            vec3 nOut = -ng;
            vec4 tint = s.coatWeight > 0.0 ? coatTransmittance(s, 1.0, 1.0) : vec4(1.0);
            tint = s.coatWeight > 0.0 ? sqrt(tint) : tint;  // 片道
            beta *= tint;
            vec3 pOut = offsetRay(hit.pos, nOut);
            vec3 t, b;
            basis(nOut, t, b);
            // 外の環境光の直接サンプリング（拡散の出射、f = 1/π）
            {
                float lightPdf;
                vec3 wi = envSample(rnd2(rng), lightPdf);
                float c = dot(wi, nOut);
                if (lightPdf > 0.0 && c > 0.0 && !occluded(pOut, wi)) {
                    float w = powerHeuristic(lightPdf, c * INV_PI);
                    L += clampRadiance(beta * INV_PI * c * envSpectrum(wi) * (w / lightPdf));
                }
            }
            vec3 l = sampleCosineHemisphere(rnd2(rng));
            dir = toWorld(l, t, b, nOut);
            prevPdf = l.z * INV_PI;
            origin = pOut;
            inside = false;
            continue;
        }

        // ---- 拡散の透過：一部の光は基材の中へ入る（確率 sssWeight で選び、重みは打ち消し合う）
        if (s.sssWeight > 0.0 && rnd(rng) < s.sssWeight) {
            vec4 tint = s.coatWeight > 0.0 ? sqrt(coatTransmittance(s, max(dot(ns, wo), 1e-3), 1.0)) : vec4(1.0);
            beta *= tint;
            vec3 nIn = -ng;
            vec3 t, b;
            basis(nIn, t, b);
            dir = toWorld(sampleCosineHemisphere(rnd2(rng)), t, b, nIn);
            origin = offsetRay(hit.pos, nIn);
            inside = true;
            insideSigma = s.sssSigma;
            prevPdf = 0.0;
            if (depth == 0u) {
                albedo = shadeAlbedoRgb(s);
                normal = ns;
            }
            continue;
        }
        if (depth == 0u) {
            albedo = shadeAlbedoRgb(s);
            normal = ns;
        }

        vec3 t, b;
        basis(ns, t, b);
        vec3 v = toLocal(wo, t, b, ns);
        if (v.z <= 1e-6) break;

        vec3 p = offsetRay(hit.pos, ng);

        // 環境光の直接サンプリング（NEE）。透過の方向は、物体自身にさえぎられるので試さない
        {
            float lightPdf;
            vec3 wi = envSample(rnd2(rng), lightPdf);
            if (lightPdf > 0.0 && dot(wi, ng) > 0.0) {
                vec3 l = toLocal(wi, t, b, ns);
                if (l.z > 0.0) {
                    vec4 f = bsdfEval(s, v, l);
                    if ((f.x + f.y + f.z + f.w) > 0.0 && !occluded(p, wi)) {
                        float bsdfPdfL = bsdfPdf(s, v, l);
                        float w = powerHeuristic(lightPdf, bsdfPdfL);
                        vec4 c = beta * f * l.z * envSpectrum(wi) * (w / lightPdf);
                        L += depth >= 1u ? clampRadiance(c) : c;
                    }
                }
            }
        }

        // BSDF サンプリング
        vec3 l = bsdfSample(s, v, rng);
        if (l.z == 0.0) break;
        float pdf = bsdfPdf(s, v, l);
        if (pdf <= 0.0) break;
        vec4 f = bsdfEval(s, v, l);
        vec3 wi = toWorld(l, t, b, ns);
        bool transmit = l.z < 0.0;
        // シェーディング法線と幾何法線の不一致で、選んだ側と反対の側に出る方向は捨てる
        if (transmit ? dot(wi, ng) >= 0.0 : dot(wi, ng) <= 0.0) break;
        beta *= f * abs(l.z) / pdf;
        prevPdf = pdf;
        if (transmit) {
            // 面を通り抜けた：表から入ったなら中の吸収を、裏から出たなら外（空気）に戻す
            mediumSigma = frontFace ? s.transSigma : vec4(0.0);
            origin = offsetRay(hit.pos, -ng);
        } else {
            origin = p;
        }
        dir = wi;

        // ロシアンルーレット
        if (depth + 1u >= F.counts.y) {
            float q = clamp(max(max(beta.x, beta.y), max(beta.z, beta.w)), 0.05, 0.95);
            if (rnd(rng) > q) break;
            beta /= q;
        }
    }

    vec3 color = spectral ? spectrumToXyz(L) : L.rgb;
    if (any(isnan(color)) || any(isinf(color))) color = vec3(0.0);
    if (spectral) albedo = rgbToXyz(albedo);

    ivec2 ip = ivec2(px);
    if (pc.sampleIndex == 0u) {
        imageStore(accumColor, ip, vec4(color, 1.0));
        imageStore(accumAlbedo, ip, vec4(albedo, 1.0));
        imageStore(accumNormal, ip, vec4(normal, 1.0));
    } else {
        imageStore(accumColor, ip, imageLoad(accumColor, ip) + vec4(color, 1.0));
        imageStore(accumAlbedo, ip, imageLoad(accumAlbedo, ip) + vec4(albedo, 1.0));
        imageStore(accumNormal, ip, imageLoad(accumNormal, ip) + vec4(normal, 1.0));
    }
}
