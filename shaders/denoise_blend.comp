#version 460
// ノイズ除去（OIDN）の結果を、トーンマッピングに渡す画像へ写す。strength で元の画像と混ぜる（1 で OIDN の結果そのまま）。
// OIDN の結果はリニア sRGB なので、累積が CIE XYZ（分光モード）なら XYZ へ戻してから混ぜる（出力は累積と同じ色空間）
#extension GL_GOOGLE_include_directive : require
#include "postfx.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D accumColor;
layout(set = 0, binding = 1, std430) readonly buffer DenoisedBuf { vec4 denoisedBuf[]; };
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D outImage;

// rust/crates/krbr-render/src/denoiser.rs の BlendPush
layout(push_constant) uniform Push {
    uint width;
    uint height;
    float strength;
    uint pad0;
    vec4 rgbToXyz0;  // 累積が XYZ のとき、リニア sRGB → XYZ の列。w = 1 なら変換する
    vec4 rgbToXyz1;
    vec4 rgbToXyz2;
} pc;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.width || p.y >= pc.height) return;
    ivec2 ip = ivec2(p);
    vec4 c = imageLoad(accumColor, ip);
    float inv = c.a > 0.0 ? 1.0 / c.a : 0.0;
    vec3 noisy = max(c.rgb * inv, vec3(0.0));
    vec3 d = applyColorMatrix(denoisedBuf[p.y * pc.width + p.x].rgb, pc.rgbToXyz0, pc.rgbToXyz1, pc.rgbToXyz2);
    // A はトーンマッピングで割る数（1）
    imageStore(outImage, ip, vec4(mix(noisy, d, clamp(pc.strength, 0.0, 1.0)), 1.0));
}
